{
  "packageId": "io.github.pagekeeper",
  "host": "pagekeeper.github.io",
  "name": "PageKeeper",
  "launcherName": "PageKeeper",
  "display": "standalone",
  "themeColor": "#0F172A",
  "themeColorDark": "#000000",
  "navigationColor": "#000000",
  "navigationColorDark": "#000000",
  "navigationDividerColor": "#000000",
  "navigationDividerColorDark": "#000000",
  "backgroundColor": "#0F172A",
  "enableNotifications": false,
  "startUrl": "/",
  "iconUrl": "https://pagekeeper.github.io/iconos/icono-512.png",
  "maskableIconUrl": "https://pagekeeper.github.io/iconos/icono-adaptable-512.png",
  "splashScreenFadeOutDuration": 300,
  "signingKey": {
    "path": "./upload.jks",
    "alias": "upload"
  },
  "appVersionName": "1.0.0",
  "appVersionCode": 1,
  "shortcuts": [],
  "generatorApp": "bubblewrap-cli",
  "webManifestUrl": "https://pagekeeper.github.io/manifest.webmanifest",
  "fallbackType": "customtabs",
  "features": {},
  "alphaDependencies": {
    "enabled": false
  },
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://pagekeeper.github.io/",
  "minSdkVersion": 24,
  "shareTarget": {
    "action": "https://pagekeeper.github.io/?compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "libros",
          "accept": [
            "application/pdf",
            "application/epub+zip"
          ]
        }
      ]
    }
  },
  "orientation": "default",
  "fingerprints": [],
  "additionalTrustedOrigins": [],
  "retainedBundles": [],
  "protocolHandlers": [],
  "fileHandlers": [
    {
      "actionUrl": "https://pagekeeper.github.io/",
      "mimeTypes": [
        "application/pdf",
        "application/epub+zip"
      ]
    }
  ],
  "launchHandlerClientMode": "",
  "displayOverride": [],
  "appVersion": "1.0.0"
}
